---
import Layout from '../layouts/Layout.astro';
---

<Layout>

<canvas id="grain"></canvas>

<div id="loader">
  <div id="ldr-content">
    <div id="ldr-logo">
      <span class="ll">D</span><span class="ll">E</span><span class="ll">N</span>
      <span class="ll">T</span><span class="ll">A</span><span class="ll">L</span>
    </div>
    <div id="ldr-tag">PREMIER CARE — BIAŁYSTOK</div>
    <div id="ldr-counter">
      <span id="ldr-num">0</span><span id="ldr-pct">%</span>
    </div>
    <div id="ldr-bar-wrap"><div id="ldr-bar"></div></div>
  </div>
  <div id="ldr-curtain-l"></div>
  <div id="ldr-curtain-r"></div>
</div>

<section id="hero">
  <canvas id="gl-canvas"></canvas>
  <div id="bg-vignette"></div>
  <div id="bg-scanlines"></div>

  <nav id="nav">
    <a href="/" id="nav-logo">
      <span class="logo-mark">✦</span>
      <span class="logo-wordmark">Dental<em>Clinic</em></span>
    </a>
    <ul id="nav-links">
      <li><a href="#" class="nl">About</a></li>
      <li><a href="#" class="nl">Services</a></li>
      <li><a href="#" class="nl">Gallery</a></li>
      <li><a href="#" class="nl">Contact</a></li>
    </ul>
    <a href="#" id="nav-cta">Book a Visit</a>
  </nav>

  <div id="hero-body">
    <div id="hero-eyebrow">
      <div class="eyebrow-line"></div>
      <span>Est. 2010 — Białystok, Poland</span>
      <div class="eyebrow-line"></div>
    </div>
    <h1 id="hero-title">
      <div class="tr">
        <div class="tm"><span class="tw">Your</span></div>
        <div class="tm ti"><span class="tw">Perfect</span></div>
      </div>
      <div class="tr">
        <div class="tm to"><span class="tw">Smile</span></div>
      </div>
      <div class="tr">
        <div class="tm"><span class="tw">Starts</span></div>
        <div class="tm tg"><span class="tw">Here.</span></div>
      </div>
    </h1>
    <div id="hero-bar">
      <p id="hero-sub">World-class dental care<br/>with a gentle human touch.</p>
      <div id="hero-stats">
        <div class="hs"><div class="hs-n">15+</div><div class="hs-l">Years</div></div>
        <div class="hs-div"></div>
        <div class="hs"><div class="hs-n">5k+</div><div class="hs-l">Patients</div></div>
        <div class="hs-div"></div>
        <div class="hs"><div class="hs-n">12</div><div class="hs-l">Specialists</div></div>
      </div>
      <a href="#" id="hero-btn">
        <span>Book a Visit</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

  <div id="marquee">
    <div id="marquee-track">
      <span class="mi">SMILE ✦</span><span class="mi">CONFIDENCE ✦</span>
      <span class="mi">EXCELLENCE ✦</span><span class="mi">CARE ✦</span>
      <span class="mi">PRECISION ✦</span><span class="mi">COMFORT ✦</span>
      <span class="mi">SMILE ✦</span><span class="mi">CONFIDENCE ✦</span>
      <span class="mi">EXCELLENCE ✦</span><span class="mi">CARE ✦</span>
      <span class="mi">PRECISION ✦</span><span class="mi">COMFORT ✦</span>
    </div>
  </div>

  <div id="side-l">
    <span class="side-txt">PREMIER DENTAL CARE</span>
    <div class="side-line"></div>
  </div>
  <div id="side-r">
    <div class="side-line"></div>
    <div id="scroll-rail"><div id="scroll-thumb"></div></div>
    <span class="side-txt">SCROLL</span>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     STATEMENT
═══════════════════════════════════════════ -->
<section id="statement">
  <div id="statement-inner">
    <div id="stmt-label">Our Philosophy</div>
    <p id="stmt-text">
      We believe great dental care is about more than just teeth —
      it is about <em>confidence</em>, <em>comfort</em>, and <em>trust</em>.
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SERVICES — HORIZONTAL SCROLL
═══════════════════════════════════════════ -->
<div id="svc-wrap">
  <div id="svc-sticky">

    <div id="svc-track">

      <!-- ── INTRO PANEL ── -->
      <div class="s-panel" id="sp-intro">
        <div class="spi-left">
          <div class="spi-eyebrow">
            <div class="spi-eline"></div>
            <span>What We Offer</span>
          </div>
          <h2 class="spi-heading">
            <span class="spi-h-top">Our</span>
            <span class="spi-h-bot">Services.</span>
          </h2>
          <p class="spi-sub">Four pillars of excellence.<br/>Every treatment a masterpiece.</p>
          <div class="spi-cue">
            <div class="spi-cue-arrow">
              <svg width="40" height="12" viewBox="0 0 40 12" fill="none">
                <path d="M0 6H38M38 6L33 1M38 6L33 11" stroke="#C8A96E" stroke-width="1"/>
              </svg>
            </div>
            <span>Scroll to explore</span>
          </div>
        </div>
        <div class="spi-right">
          <div class="spi-list">
            <div class="spl-item">
              <span class="spl-n">01</span>
              <span class="spl-name">Teeth Whitening</span>
              <div class="spl-line"></div>
            </div>
            <div class="spl-item">
              <span class="spl-n">02</span>
              <span class="spl-name">Orthodontics</span>
              <div class="spl-line"></div>
            </div>
            <div class="spl-item">
              <span class="spl-n">03</span>
              <span class="spl-name">Dental Implants</span>
              <div class="spl-line"></div>
            </div>
            <div class="spl-item">
              <span class="spl-n">04</span>
              <span class="spl-name">Porcelain Veneers</span>
              <div class="spl-line"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ── SERVICE 01: WHITENING ── -->
      <div class="s-panel s-svc" data-svc="01">
        <div class="ss-img-col">
          <div class="ss-img-clip">
            <div class="ss-img" style="background-image:url('https://images.unsplash.com/photo-1606811841689-23dfddce3e95?w=1200&q=85&fit=crop')"></div>
            <div class="ss-img-grain"></div>
          </div>
          <div class="ss-bg-num">01</div>
        </div>
        <div class="ss-info-col">
          <div class="ss-info-inner">
            <div class="ss-tag">Cosmetic Dentistry</div>
            <h3 class="ss-name">Teeth<br/>Whitening</h3>
            <div class="ss-rule"></div>
            <p class="ss-desc">Professional-grade whitening that lifts years of staining in a single session. Clinically safe, dramatically effective — visible results from your very first appointment.</p>
            <div class="ss-stats">
              <div class="ss-stat">
                <div class="ss-stat-val">60 min</div>
                <div class="ss-stat-key">Per session</div>
              </div>
              <div class="ss-stat-sep"></div>
              <div class="ss-stat">
                <div class="ss-stat-val">From 800 PLN</div>
                <div class="ss-stat-key">Starting price</div>
              </div>
              <div class="ss-stat-sep"></div>
              <div class="ss-stat">
                <div class="ss-stat-val">8 shades</div>
                <div class="ss-stat-key">Average lift</div>
              </div>
            </div>
            <a href="#" class="ss-btn">
              <span>Book This Treatment</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7H13M13 7L8 2M13 7L8 12" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- ── SERVICE 02: ORTHODONTICS ── -->
      <div class="s-panel s-svc" data-svc="02">
        <div class="ss-img-col">
          <div class="ss-img-clip">
            <div class="ss-img" style="background-image:url('https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=1200&q=85&fit=crop')"></div>
            <div class="ss-img-grain"></div>
          </div>
          <div class="ss-bg-num">02</div>
        </div>
        <div class="ss-info-col">
          <div class="ss-info-inner">
            <div class="ss-tag">Corrective Care</div>
            <h3 class="ss-name">Ortho<br/>dontics</h3>
            <div class="ss-rule"></div>
            <p class="ss-desc">Precision alignment using the latest invisible braces and clear aligner technology. Discreet, comfortable, and life-changing — engineered around your lifestyle.</p>
            <div class="ss-stats">
              <div class="ss-stat">
                <div class="ss-stat-val">12–24 mo</div>
                <div class="ss-stat-key">Treatment</div>
              </div>
              <div class="ss-stat-sep"></div>
              <div class="ss-stat">
                <div class="ss-stat-val">From 4 500 PLN</div>
                <div class="ss-stat-key">Starting price</div>
              </div>
              <div class="ss-stat-sep"></div>
              <div class="ss-stat">
                <div class="ss-stat-val">Invisible</div>
                <div class="ss-stat-key">Technology</div>
              </div>
            </div>
            <a href="#" class="ss-btn">
              <span>Book This Treatment</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7H13M13 7L8 2M13 7L8 12" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- ── SERVICE 03: IMPLANTS ── -->
      <div class="s-panel s-svc" data-svc="03">
        <div class="ss-img-col">
          <div class="ss-img-clip">
            <div class="ss-img" style="background-image:url('https://images.unsplash.com/photo-1629909615184-74f495363b67?w=1200&q=85&fit=crop')"></div>
            <div class="ss-img-grain"></div>
          </div>
          <div class="ss-bg-num">03</div>
        </div>
        <div class="ss-info-col">
          <div class="ss-info-inner">
            <div class="ss-tag">Restorative Surgery</div>
            <h3 class="ss-name">Dental<br/>Implants</h3>
            <div class="ss-rule"></div>
            <p class="ss-desc">Titanium-root implants that fuse with your bone and look, feel, and function exactly like your natural teeth. The gold standard of tooth replacement — built to last a lifetime.</p>
            <div class="ss-stats">
              <div class="ss-stat">
                <div class="ss-stat-val">1–2 visits</div>
                <div class="ss-stat-key">Placement</div>
              </div>
              <div class="ss-stat-sep"></div>
              <div class="ss-stat">
                <div class="ss-stat-val">From 3 200 PLN</div>
                <div class="ss-stat-key">Per implant</div>
              </div>
              <div class="ss-stat-sep"></div>
              <div class="ss-stat">
                <div class="ss-stat-val">Lifetime</div>
                <div class="ss-stat-key">Durability</div>
              </div>
            </div>
            <a href="#" class="ss-btn">
              <span>Book This Treatment</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7H13M13 7L8 2M13 7L8 12" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- ── SERVICE 04: VENEERS ── -->
      <div class="s-panel s-svc" data-svc="04">
        <div class="ss-img-col">
          <div class="ss-img-clip">
            <div class="ss-img" style="background-image:url('https://images.unsplash.com/photo-1519340241574-2cec6aef0c01?w=1200&q=85&fit=crop')"></div>
            <div class="ss-img-grain"></div>
          </div>
          <div class="ss-bg-num">04</div>
        </div>
        <div class="ss-info-col">
          <div class="ss-info-inner">
            <div class="ss-tag">Aesthetic Perfection</div>
            <h3 class="ss-name">Porcelain<br/>Veneers</h3>
            <div class="ss-rule"></div>
            <p class="ss-desc">Ultra-thin porcelain shells custom-crafted to perfection and bonded to your teeth. Shape, colour, symmetry — every detail sculpted for a smile that is unmistakably you.</p>
            <div class="ss-stats">
              <div class="ss-stat">
                <div class="ss-stat-val">2 visits</div>
                <div class="ss-stat-key">To complete</div>
              </div>
              <div class="ss-stat-sep"></div>
              <div class="ss-stat">
                <div class="ss-stat-val">From 2 000 PLN</div>
                <div class="ss-stat-key">Per veneer</div>
              </div>
              <div class="ss-stat-sep"></div>
              <div class="ss-stat">
                <div class="ss-stat-val">10–15 yr</div>
                <div class="ss-stat-key">Lifespan</div>
              </div>
            </div>
            <a href="#" class="ss-btn">
              <span>Book This Treatment</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7H13M13 7L8 2M13 7L8 12" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
            </a>
          </div>
        </div>
      </div>

    </div><!-- end svc-track -->

    <!-- Progress bar -->
    <div id="svc-prog-wrap">
      <div id="svc-prog-bar"></div>
    </div>

    <!-- Panel counter -->
    <div id="svc-count">
      <span id="svc-cur">01</span>
      <span class="svc-count-sep"> / </span>
      <span id="svc-tot">05</span>
    </div>

  </div><!-- end svc-sticky -->
</div><!-- end svc-wrap -->

<!-- ═══════════════════════════════════════════
     FINAL CTA
═══════════════════════════════════════════ -->
<section id="final-cta">
  <div id="fcta-inner">
    <div id="fcta-label">Ready to Begin?</div>
    <h2 id="fcta-heading">Your smile is<br/><em>waiting for you.</em></h2>
    <a href="#" id="fcta-btn">
      <span>Book Your First Visit</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
  <div id="fcta-deco">✦</div>
</section>

</Layout>

<style>
/* ── GRAIN ── */
#grain{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9998;opacity:.04;}

/* ── LOADER ── */
#loader{position:fixed;inset:0;z-index:9000;display:flex;align-items:center;justify-content:center;overflow:hidden;}
#ldr-curtain-l,#ldr-curtain-r{position:absolute;top:0;bottom:0;width:50%;background:#080808;z-index:1;}
#ldr-curtain-l{left:0;}#ldr-curtain-r{right:0;}
#ldr-content{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:2rem;}
#ldr-logo{display:flex;gap:.1em;font-family:'Playfair Display',serif;font-size:clamp(2.5rem,8vw,6rem);font-weight:700;letter-spacing:.5em;color:#F0ECE4;}
.ll{display:inline-block;opacity:0;transform:translateY(50px) rotate(8deg);}
#ldr-tag{font-size:.62rem;letter-spacing:.45em;text-transform:uppercase;color:rgba(200,169,110,.65);opacity:0;}
#ldr-counter{font-family:'Playfair Display',serif;font-size:clamp(4rem,13vw,9rem);font-weight:400;color:#C8A96E;line-height:1;letter-spacing:-.03em;display:flex;align-items:flex-start;}
#ldr-pct{font-size:.38em;margin-top:.28em;opacity:.45;}
#ldr-bar-wrap{width:280px;height:1px;background:rgba(240,236,228,.1);overflow:hidden;}
#ldr-bar{height:100%;width:0%;background:linear-gradient(90deg,transparent,#C8A96E);}

/* ── HERO ── */
#hero{position:relative;width:100%;height:100vh;min-height:680px;display:flex;flex-direction:column;overflow:hidden;background:#080808;}
#gl-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:1;display:block;}
#bg-vignette{position:absolute;inset:0;z-index:2;pointer-events:none;background:radial-gradient(ellipse 80% 85% at 50% 50%,transparent 20%,rgba(8,8,8,.82) 100%);}
#bg-scanlines{position:absolute;inset:0;pointer-events:none;z-index:3;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,.022) 2px,rgba(0,0,0,.022) 4px);}

/* NAV */
#nav{position:absolute;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:2.2rem 4rem;opacity:0;}
#nav-logo{display:flex;align-items:center;gap:.75rem;text-decoration:none;}
.logo-mark{font-size:1.1rem;color:#C8A96E;}
.logo-wordmark{font-family:'Playfair Display',serif;font-size:1rem;font-weight:400;letter-spacing:.12em;text-transform:uppercase;color:#F0ECE4;}
.logo-wordmark em{font-style:italic;font-size:.78rem;letter-spacing:.28em;opacity:.55;display:block;margin-top:-2px;}
#nav-links{display:flex;gap:3rem;list-style:none;}
.nl{color:rgba(240,236,228,.6);text-decoration:none;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;position:relative;transition:color .3s;}
.nl::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:1px;background:#C8A96E;transition:width .4s cubic-bezier(.25,1,.5,1);}
.nl:hover{color:#F0ECE4;}.nl:hover::after{width:100%;}
#nav-cta{color:#C8A96E;text-decoration:none;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;border:1px solid rgba(200,169,110,.38);padding:.65rem 1.5rem;transition:background .4s,color .4s;}
#nav-cta:hover{background:#C8A96E;color:#080808;}

/* HERO BODY */
#hero-body{position:relative;z-index:10;flex:1;display:flex;flex-direction:column;justify-content:flex-end;padding:0 4rem 2rem;gap:2rem;}
#hero-eyebrow{display:flex;align-items:center;gap:1rem;font-size:.63rem;letter-spacing:.38em;text-transform:uppercase;color:rgba(200,169,110,.8);opacity:0;transform:translateY(14px);}
.eyebrow-line{flex:0 0 36px;height:1px;background:rgba(200,169,110,.35);}
#hero-title{display:flex;flex-direction:column;gap:0;}
.tr{display:flex;align-items:baseline;gap:.28em;line-height:1;}
.tm{overflow:hidden;}
.tw{display:block;font-family:'Playfair Display',serif;font-size:clamp(4.5rem,11.5vw,11rem);font-weight:700;color:#F0ECE4;letter-spacing:-.025em;line-height:.9;transform:translateY(112%);will-change:transform;}
.ti .tw{font-style:italic;font-weight:400;color:rgba(240,236,228,.7);}
.to .tw{-webkit-text-stroke:2px #F0ECE4;color:transparent;}
.tg .tw{color:#C8A96E;}
#hero-bar{display:flex;align-items:center;justify-content:space-between;padding-top:1.6rem;border-top:1px solid rgba(240,236,228,.1);opacity:0;transform:translateY(22px);}
#hero-sub{font-size:.82rem;font-weight:300;line-height:1.85;color:rgba(240,236,228,.48);letter-spacing:.04em;}
#hero-stats{display:flex;align-items:center;gap:2.2rem;}
.hs{text-align:center;}
.hs-n{font-family:'Playfair Display',serif;font-size:2rem;font-weight:400;color:#C8A96E;line-height:1;}
.hs-l{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(240,236,228,.38);margin-top:.35rem;}
.hs-div{width:1px;height:38px;background:rgba(240,236,228,.1);}
#hero-btn{display:flex;align-items:center;gap:.85rem;color:#080808;text-decoration:none;font-size:.75rem;letter-spacing:.22em;text-transform:uppercase;padding:1.2rem 2.8rem;background:#F0ECE4;border:1px solid #F0ECE4;position:relative;overflow:hidden;transition:gap .5s,box-shadow .4s;box-shadow:0 8px 32px rgba(240,236,228,.18);}
#hero-btn:hover{box-shadow:0 8px 48px rgba(240,236,228,.35);gap:1.5rem;}
#hero-btn::before{content:'';position:absolute;inset:0;background:#fff;transform:scaleX(0);transform-origin:left;transition:transform .55s cubic-bezier(.77,0,.18,1);}
#hero-btn:hover::before{transform:scaleX(1);}
#hero-btn span,#hero-btn svg{position:relative;z-index:1;}

/* MARQUEE */
#marquee{position:relative;z-index:20;overflow:hidden;border-top:1px solid rgba(240,236,228,.07);background:rgba(8,8,8,.5);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);padding:.88rem 0;opacity:0;}
#marquee-track{display:flex;white-space:nowrap;animation:marqueeRun 22s linear infinite;}
.mi{font-size:.6rem;letter-spacing:.42em;text-transform:uppercase;color:rgba(240,236,228,.28);padding:0 1.8rem;flex-shrink:0;}
@keyframes marqueeRun{from{transform:translateX(0);}to{transform:translateX(-50%);}}

/* SIDES */
#side-l,#side-r{position:absolute;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;align-items:center;gap:1rem;z-index:30;opacity:0;}
#side-l{left:1.5rem;}#side-r{right:1.5rem;}
.side-txt{writing-mode:vertical-rl;font-size:.5rem;letter-spacing:.35em;text-transform:uppercase;color:rgba(240,236,228,.28);}
.side-line{width:1px;height:80px;background:rgba(240,236,228,.1);}
#scroll-rail{width:1px;height:65px;background:rgba(240,236,228,.1);position:relative;overflow:hidden;}
#scroll-thumb{position:absolute;top:-45%;width:100%;height:45%;background:linear-gradient(to bottom,transparent,#C8A96E);animation:scrollDrop 2.2s cubic-bezier(.4,0,.6,1) infinite;}
@keyframes scrollDrop{0%{top:-45%;opacity:0;}25%{opacity:1;}100%{top:145%;opacity:0;}}

/* ── STATEMENT ── */
#statement{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:10rem 4rem;background:#080808;}
#statement-inner{max-width:960px;text-align:center;}
#stmt-label{font-size:.62rem;letter-spacing:.42em;text-transform:uppercase;color:rgba(200,169,110,.7);margin-bottom:3rem;opacity:0;transform:translateY(16px);}
#stmt-text{font-family:'Playfair Display',serif;font-size:clamp(2rem,4.5vw,4.5rem);font-weight:400;line-height:1.28;color:rgba(240,236,228,.88);opacity:0;transform:translateY(48px);}
#stmt-text em{font-style:italic;color:#C8A96E;}

/* ══════════════════════════════════════════════
   SERVICES HORIZONTAL SCROLL
══════════════════════════════════════════════ */
#svc-wrap{
  height: 550vh;
  position: relative;
}
#svc-sticky{
