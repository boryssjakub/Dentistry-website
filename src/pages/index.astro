<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import Lenis from 'lenis';

gsap.registerPlugin(ScrollTrigger);

/* ── GRAIN ── */
const grainCanvas=document.getElementById('grain') as HTMLCanvasElement;
const gCtx=grainCanvas.getContext('2d')!;
function resizeGrain(){grainCanvas.width=window.innerWidth;grainCanvas.height=window.innerHeight;}
resizeGrain(); window.addEventListener('resize',resizeGrain);
let gf=0;
(function tg(){
  if(++gf%2===0){
    const w=grainCanvas.width,h=grainCanvas.height,img=gCtx.createImageData(w,h),d=img.data;
    for(let i=0;i<d.length;i+=4){const v=(Math.random()*255)|0;d[i]=d[i+1]=d[i+2]=v;d[i+3]=255;}
    gCtx.putImageData(img,0,0);
  }
  requestAnimationFrame(tg);
})();

/* ── LENIS ── */
const lenis=new Lenis({duration:1.65,easing:(t:number)=>Math.min(1,1.001-Math.pow(2,-10*t))});
lenis.on('scroll',ScrollTrigger.update);
gsap.ticker.add((time)=>lenis.raf(time*1000));
gsap.ticker.lagSmoothing(0);

/* ── LOADER ── */
const cObj={val:0};
const ldrNum=document.getElementById('ldr-num')!;
const ldrEl=document.getElementById('loader')!;
const ldrTl=gsap.timeline({onComplete:()=>{ldrEl.style.display='none';}});
ldrTl
  .to('.ll',{opacity:1,y:0,rotate:0,duration:.75,stagger:.07,ease:'power3.out'})
  .to('#ldr-tag',{opacity:1,duration:.5,ease:'power2.out'},'-=.3')
  .to(cObj,{val:100,duration:1.7,ease:'power2.inOut',onUpdate(){ldrNum.textContent=String(Math.round(cObj.val));}},'-=.1')
  .to('#ldr-bar',{width:'100%',duration:1.7,ease:'power2.inOut'},'<')
  .to('#ldr-content',{opacity:0,duration:.35,ease:'power2.in'},'+=.25')
  .to('#ldr-curtain-l',{xPercent:-100,duration:1.1,ease:'power4.inOut'},'-=.1')
  .to('#ldr-curtain-r',{xPercent:100,duration:1.1,ease:'power4.inOut'},'<');

/* ── HERO ENTRANCE ── */
gsap.timeline({delay:3.1})
  .to('#nav',{opacity:1,duration:1,ease:'power3.out'})
  .to('#hero-eyebrow',{opacity:1,y:0,duration:.85,ease:'power3.out'},'-=.65')
  .to('.tw',{y:'0%',duration:1.25,stagger:.1,ease:'power4.out'},'-=.6')
  .to('#hero-bar',{opacity:1,y:0,duration:1,ease:'power3.out'},'-=.5')
  .to('#marquee',{opacity:1,duration:.8,ease:'power2.out'},'-=.5')
  .to('#side-l,#side-r',{opacity:1,duration:.7},'-=.5');

/* ── HERO SCROLL FADE ── */
gsap.to('#hero-body',{yPercent:18,opacity:0,ease:'none',scrollTrigger:{trigger:'#hero',start:'top top',end:'55% top',scrub:1.2}});

/* ── STATEMENT ── */
gsap.to('#stmt-label',{opacity:1,y:0,duration:1,ease:'power3.out',scrollTrigger:{trigger:'#statement',start:'top 72%'}});
gsap.to('#stmt-text',{opacity:1,y:0,duration:1.4,ease:'power3.out',scrollTrigger:{trigger:'#statement',start:'top 68%'}});

/* ══════════════════════════════════════════════
   SERVICES HORIZONTAL SCROLL
══════════════════════════════════════════════ */
const svcTrack = document.getElementById('svc-track')!;
const progBar  = document.getElementById('svc-prog-bar')!;
const svcCur   = document.getElementById('svc-cur')!;
const panels   = document.querySelectorAll('.s-panel');
const TOTAL    = panels.length; // 5

// Main horizontal tween
const hTween = gsap.to(svcTrack, {
  x: () => -(svcTrack.scrollWidth - window.innerWidth),
  ease: 'none',
  scrollTrigger: {
    trigger: '#svc-wrap',
    start: 'top top',
    end: 'bottom bottom',
    scrub: 1.5,
    pin: '#svc-sticky',
    anticipatePin: 1,
    onUpdate(self) {
      // Progress bar
      progBar.style.width = (self.progress * 100) + '%';
      // Panel counter
      const idx = Math.min(Math.round(self.progress * (TOTAL - 1)) + 1, TOTAL);
      svcCur.textContent = String(idx).padStart(2, '0');
    }
  }
});

/* ── Intro panel list stagger ── */
ScrollTrigger.create({
  trigger: '#svc-wrap',
  start: 'top 80%',
  onEnter: () => {
    gsap.to('.spl-item', {
      opacity: 1,
      x: 0,
      duration: .8,
      stagger: .12,
      ease: 'power3.out',
    });
  }
});

/* ── Per-service panel reveals ── */
document.querySelectorAll('.s-svc').forEach((panel) => {
  const clip  = panel.querySelector('.ss-img-clip') as HTMLElement;
  const info  = panel.querySelector('.ss-info-inner') as HTMLElement;

  // Image wipes up from bottom
  gsap.to(clip, {
    clipPath: 'inset(0% 0 0 0)',
    duration: 1.2,
    ease: 'power4.out',
    scrollTrigger: {
      trigger: panel,
      containerAnimation: hTween,
      start: 'left 85%',
      toggleActions: 'play none none reverse',
    }
  });

  // Info block rises up
  gsap.to(info, {
    opacity: 1,
    y: 0,
    duration: 1,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: panel,
      containerAnimation: hTween,
      start: 'left 65%',
      toggleActions: 'play none none reverse',
    }
  });
});

/* ── Final CTA ── */
gsap.to('#fcta-label',{opacity:1,y:0,duration:.9,ease:'power3.out',scrollTrigger:{trigger:'#final-cta',start:'top 75%'}});
gsap.to('#fcta-heading',{opacity:1,y:0,duration:1.1,ease:'power3.out',scrollTrigger:{trigger:'#final-cta',start:'top 70%'}});
gsap.to('#fcta-btn',{opacity:1,y:0,duration:.9,ease:'power3.out',scrollTrigger:{trigger:'#final-cta',start:'top 65%'}});

/* ══════════════════════════════════════════════
   WEBGL LIQUID DISTORTION
══════════════════════════════════════════════ */
const glCanvas=document.getElementById('gl-canvas') as HTMLCanvasElement;
const glMaybe=glCanvas.getContext('webgl',{alpha:false,antialias:false,powerPreference:'high-performance'});

if(glMaybe){
const gl=glMaybe;
const VERT=`attribute vec2 aPos;varying vec2 vUv;void main(){vUv=aPos*.5+.5;gl_Position=vec4(aPos,0.,1.);}`;
const FRAG=`
precision highp float;
uniform sampler2D uTex1;uniform sampler2D uTex2;
uniform vec2 uMouse;uniform vec2 uVel;uniform float uRadius;
uniform float uTime;uniform vec2 uRes;uniform float uScroll;
varying vec2 vUv;
vec3 m289(vec3 x){return x-floor(x*(1./289.))*289.;}
vec2 m289(vec2 x){return x-floor(x*(1./289.))*289.;}
vec3 prm(vec3 x){return m289(((x*34.)+1.)*x);}
float snoise(vec2 v){
  const vec4 C=vec4(.211324865405187,.366025403784439,-.577350269189626,.024390243902439);
  vec2 i=floor(v+dot(v,C.yy));vec2 x0=v-i+dot(i,C.xx);
  vec2 i1=(x0.x>x0.y)?vec2(1.,0.):vec2(0.,1.);
  vec4 x12=x0.xyxy+C.xxzz;x12.xy-=i1;i=m289(i);
  vec3 p=prm(prm(i.y+vec3(0.,i1.y,1.))+i.x+vec3(0.,i1.x,1.));
  vec3 m=max(.5-vec3(dot(x0,x0),dot(x12.xy,x12.xy),dot(x12.zw,x12.zw)),0.);
  m=m*m;m=m*m;
  vec3 x2=2.*fract(p*C.www)-1.;vec3 h=abs(x2)-.5;
  vec3 ox=floor(x2+.5);vec3 a0=x2-ox;
  m*=1.79284291400159-.85373472095314*(a0*a0+h*h);
  vec3 g;g.x=a0.x*x0.x+h.x*x0.y;g.yz=a0.yz*x12.xz+h.yz*x12.yw;
  return 130.*dot(m,g);
}
vec2 cover(vec2 uv,float ia,float ca){
  float sx=1.,sy=1.;
  if(ca>ia)sy=ia/ca;else sx=ca/ia;
  return(uv-.5)/vec2(sx,sy)+.5;
}
void main(){
  vec2 uv=vec2(vUv.x,1.-vUv.y);
  float ca=uRes.x/uRes.y;
  vec2 uv1=cover(uv,1.5,ca);
  vec2 uv2=cover(uv,1.5,ca);
  uv1.y+=uScroll*.14;uv2.y+=uScroll*.08;
  vec2 diff=(uv-uMouse)*vec2(ca,1.);
  float dist=length(diff);
  float vel=length(uVel);
  float ang=atan(diff.y,diff.x);
  float amp=.024+vel*.20;
  float n=snoise(vec2(ang*5.,uTime*.65))*amp
         +snoise(vec2(ang*11.+1.7,uTime*1.1))*amp*.5
         +snoise(vec2(ang*2.3-.9,uTime*.35))*amp*.3;
  float ripple=snoise(uv*8.-uTime*.5+vel*3.)*vel*.03;
  n+=ripple;
  float dDist=dist+n;
  float edgeW=.010+amp*.9;
  float circle=1.-smoothstep(uRadius-edgeW,uRadius+edgeW,dDist);
  float em=smoothstep(uRadius-.07,uRadius,dDist)*(1.-smoothstep(uRadius,uRadius+.07,dDist));
  float dn=snoise(uv*5.+uTime*.4)*.5+snoise(uv*10.-uTime*.3)*.25;
  vec2 dir=length(diff)>.001?normalize(diff):vec2(0.);
  vec2 disp=(dir*.018+vec2(n*.012))*em*(1.+vel*5.);
  vec4 c1=texture2D(uTex1,clamp(uv1+disp*(1.-circle),.001,.999));
  vec4 c2=texture2D(uTex2,clamp(uv2-disp*circle,.001,.999));
  c1.rgb*=.70;
  vec4 color=mix(c1,c2,circle);
  float g1=smoothstep(uRadius-.006,uRadius,dDist)*(1.-smoothstep(uRadius,uRadius+.006,dDist));
  float g2=smoothstep(uRadius-.002,uRadius,dDist)*(1.-smoothstep(uRadius,uRadius+.002,dDist))*2.5;
  float glow=(g1+g2)*(1.+vel*3.)*min(uRadius*12.,1.);
  color.rgb+=glow*vec3(.784,.663,.431);
  float innerVig=(1.-smoothstep(.0,.3,dist/max(uRadius,.001)))*circle*.25;
  color.rgb*=(1.-innerVig);
  gl_FragColor=color;
}`;

function compile(type:number,src:string){
  const s=gl.createShader(type)!;
  gl.shaderSource(s,src);gl.compileShader(s);
  if(!gl.getShaderParameter(s,gl.COMPILE_STATUS))console.error(gl.getShaderInfoLog(s));
  return s;
}
const prog=gl.createProgram()!;
gl.attachShader(prog,compile(gl.VERTEX_SHADER,VERT));
gl.attachShader(prog,compile(gl.FRAGMENT_SHADER,FRAG));
gl.linkProgram(prog);gl.useProgram(prog);

const buf=gl.createBuffer();
gl.bindBuffer(gl.ARRAY_BUFFER,buf);
gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,1,-1,-1,1,1,1]),gl.STATIC_DRAW);
const aPos=gl.getAttribLocation(prog,'aPos');
gl.enableVertexAttribArray(aPos);
gl.vertexAttribPointer(aPos,2,gl.FLOAT,false,0,0);

const U={
  tex1:gl.getUniformLocation(prog,'uTex1'),tex2:gl.getUniformLocation(prog,'uTex2'),
  mouse:gl.getUniformLocation(prog,'uMouse'),vel:gl.getUniformLocation(prog,'uVel'),
  radius:gl.getUniformLocation(prog,'uRadius'),time:gl.getUniformLocation(prog,'uTime'),
  res:gl.getUniformLocation(prog,'uRes'),scroll:gl.getUniformLocation(prog,'uScroll'),
};

function makeTex(unit:number):WebGLTexture{
  const t=gl.createTexture()!;
  gl.activeTexture(gl.TEXTURE0+unit);gl.bindTexture(gl.TEXTURE_2D,t);
  gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,1,1,0,gl.RGBA,gl.UNSIGNED_BYTE,new Uint8Array([10,10,10,255]));
  gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);
  gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);
  gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);
  return t;
}
function loadTex(url:string,unit:number,tex:WebGLTexture){
  const img=new Image();img.crossOrigin='anonymous';
  img.onload=()=>{
    gl.activeTexture(gl.TEXTURE0+unit);gl.bindTexture(gl.TEXTURE_2D,tex);
    gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,gl.RGBA,gl.UNSIGNED_BYTE,img);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);
  };
  img.src=url;
}

const tex1=makeTex(0),tex2=makeTex(1);
loadTex('https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=1800&q=80&fm=jpg&fit=crop',0,tex1);
loadTex('https://images.unsplash.com/photo-1606811841689-23dfddce3e95?w=1800&q=80&fm=jpg&fit=crop',1,tex2);
gl.uniform1i(U.tex1,0);gl.uniform1i(U.tex2,1);

function resizeGL(){
  const h=document.getElementById('hero')!;
  const w=h.clientWidth,ht=h.clientHeight;
  glCanvas.width=w;glCanvas.height=ht;
  gl.viewport(0,0,w,ht);
  gl.uniform2f(U.res,w,ht);
}
resizeGL();window.addEventListener('resize',resizeGL);

let mX=.5,mY=.5,tmX=.5,tmY=.5,vX=0,vY=0,pmX=.5,pmY=.5;
let radius=0,tRadius=0,scrollProg=0;
const hero=document.getElementById('hero')!;

hero.addEventListener('mousemove',e=>{
  const r=hero.getBoundingClientRect();
  tmX=(e.clientX-r.left)/r.width;
  tmY=(e.clientY-r.top)/r.height;
});
hero.addEventListener('mouseenter',()=>{tRadius=.22;});
hero.addEventListener('mouseleave',()=>{tRadius=0;});

ScrollTrigger.create({
  trigger:'#hero',start:'top top',end:'bottom top',
  onUpdate:self=>{scrollProg=self.progress;tRadius=self.progress>.1?0:.22;}
});

const t0=performance.now();
(function frame(){
  const t=(performance.now()-t0)*.001;
  mX+=(tmX-mX)*.065;mY+=(tmY-mY)*.065;
  vX=(mX-pmX)*30;vY=(mY-pmY)*30;
  pmX=mX;pmY=mY;
  radius+=(tRadius-radius)*.055;
  gl.uniform2f(U.mouse,mX,mY);
  gl.uniform2f(U.vel,vX,vY);
  gl.uniform1f(U.radius,radius);
  gl.uniform1f(U.time,t);
  gl.uniform1f(U.scroll,scrollProg);
  gl.drawArrays(gl.TRIANGLE_STRIP,0,4);
  requestAnimationFrame(frame);
})();
} // end if(gl)
</script>